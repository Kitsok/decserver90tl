+void duart_channel::start_pending_tx(bool ready)
+{
+	if (!m_tx_data_in_buffer || !is_transmit_register_empty() || !m_tx_enabled)
+		return;
+	// CTS is sampled between characters, never halfway through a frame.
+	// A held byte remains in the THR, with TxRDY clear, until CTS returns.
+	if ((MR2 & 0x10) && !m_cts_asserted && (MR2 & 0xc0) == 0)
+		return;
+	transmit_register_setup(m_tx_data);
+	m_bits_transmitted = 0;
+	m_tx_data_in_buffer = false;
+	if ((MR2 & 0xc0) != 0x80) m_write_byte(m_tx_data);
+	if (ready) SR |= STATUS_TRANSMITTER_READY;
+	update_interrupts();
+}
+
+void duart_channel::tx_cts_w(bool asserted)
+{
+	if (m_cts_asserted == asserted) return;
+	m_cts_asserted = asserted;
+	if (asserted) start_pending_tx(true);
+}
