+void netdev_tap::capture(void const *buf, int len, const char *direction)
+{
+	if (len <= 0) return;
+	const auto *bytes = static_cast<const uint8_t *>(buf);
+	if (len >= 14)
+		osd_printf_info("DS90 NETWORK-%s bytes=%d dst=%02x:%02x:%02x:%02x:%02x:%02x src=%02x:%02x:%02x:%02x:%02x:%02x type=%02x%02x\n",
+			direction, len, bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5],
+			bytes[6], bytes[7], bytes[8], bytes[9], bytes[10], bytes[11], bytes[12], bytes[13]);
+	std::fflush(stdout);
+	if (!m_capture) return;
+	const auto micros = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::system_clock::now().time_since_epoch()).count();
+	uint8_t header[16];
+	const uint32_t fields[] = {uint32_t(micros / 1000000), uint32_t(micros % 1000000), uint32_t(len), uint32_t(len)};
+	for (unsigned word = 0; word < 4; ++word)
+		for (unsigned byte = 0; byte < 4; ++byte)
+			header[word * 4 + byte] = fields[word] >> (byte * 8);
+	if (std::fwrite(header, 1, sizeof(header), m_capture) != sizeof(header)
+		|| std::fwrite(buf, 1, len, m_capture) != size_t(len) || std::fflush(m_capture))
+		throw std::runtime_error("TAP packet capture write failed");
 }
 
