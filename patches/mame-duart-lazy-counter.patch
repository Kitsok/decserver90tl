+void duart_base_device::sync_lazy_ct()
+{
+	if (!m_ct_lazy) return;
+	const attotime now = machine().time();
+	if (m_ct_next > now) return;
+	// The first pending edge retains its original deadline. Subsequent
+	// reloads use the current preset/source, just like the callback. All
+	// register changes synchronize before modifying either of these.
+	const attotime period = attotime::from_ticks(std::max(CTR.w.l, uint16_t(1)), get_ct_rate());
+	bool ready = false;
+	while (m_ct_next <= now)
+	{
+		const attotime elapsed = now - m_ct_next;
+		uint32_t reloads;
+		if (!elapsed.seconds() && !period.seconds())
+			reloads = uint32_t(std::min(uint64_t(0xffffffffU), uint64_t(elapsed.attoseconds() / period.attoseconds())));
+		else
+		{
+			// Bound multiplication to u32; very long gaps are handled in
+			// chunks without narrowing an unbounded elapsed tick count.
+			uint32_t low = 0, high = 0xffffffffU;
+			while (low < high)
+			{
+				const uint32_t middle = low + uint32_t((uint64_t(high) - low + 1) / 2);
+				if (period * middle <= elapsed) low = middle;
+				else high = middle - 1;
+			}
+			reloads = low;
+		}
+		// reloads+1 edges: any pair crosses a ready edge; a single edge
+		// does so only when the previous half-period was high.
+		ready |= reloads != 0 || half_period != 0;
+		half_period ^= uint8_t((uint64_t(reloads) + 1) & 1);
+		m_ct_next += period * reloads;
+		m_ct_next += period;
+	}
+	if (ready) set_ISR_bits(INT_COUNTER_READY);
+}
