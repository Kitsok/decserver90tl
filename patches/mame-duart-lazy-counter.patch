+void duart_base_device::update_lazy_ct()
+{
+	if (!m_lazy_timer_enabled) return;
+	const uint8_t a = m_chanA->get_chan_CSR(), b = m_chanB->get_chan_CSR();
+	// Internal timer sources only. Masking the ready IRQ is insufficient:
+	// OP3 or either channel can still consume every counter transition.
+	const bool lazy = (ACR & 0x60) == 0x60 && get_ct_rate() != 0
+		&& !(IMR & INT_COUNTER_READY) && (OPCR & 0x0c) != 0x04
+		&& (a & 0x0f) != 0x0d && (a >> 4) != 0x0d
+		&& (b & 0x0f) != 0x0d && (b >> 4) != 0x0d
+		&& !m_chanC && !m_chanD;
+	if (m_ct_lazy && !lazy)
+	{
+		// Callers already synchronized using the old register values.
+		m_ct_lazy = false;
+		duart_timer->adjust(m_ct_next - machine().time());
+	}
+	else if (!m_ct_lazy && lazy && duart_timer->enabled() && !duart_timer->expire().is_never())
+	{
+		m_ct_next = duart_timer->expire();
+		m_ct_lazy = true;
+		duart_timer->adjust(attotime::never);
+	}
